generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  mobile        String
  passwordHash  String
  role          String         @default("STUDENT") // STUDENT, OWNER, ADMIN
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  student       Student?
  owner         Owner?
  notifications Notification[]
}

model Student {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  college          String?
  course           String?
  year             String?
  emergencyContact String?

  bookings         Booking[]
  rents            Rent[]
  payments         Payment[]
  complaints       Complaint[]
}

model Owner {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationStatus String         @default("VERIFIED") // PENDING, VERIFIED, REJECTED

  pgs                PG[]
  announcements      Announcement[]
}

model PG {
  id            String         @id @default(cuid())
  ownerId       String
  owner         Owner          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  address       String
  city          String
  latitude      Float?
  longitude     Float?
  status        String         @default("ACTIVE") // ACTIVE, INACTIVE, PENDING
  images          String         @default("[]") // JSON string of image URLs
  facilities      String         @default("[]") // JSON string of facilities array
  rules           String         @default("[]") // JSON string of PG rules array
  qrCodeUrl       String?        // Owner's UPI QR Code URL
  upiId           String?        // Owner's UPI ID (e.g. owner@upi)
  contactMobile   String?        // Dedicated PG contact mobile
  licenseNumber   String?        // Legal Trade / Municipal License No.
  legalPermission String?        // Police NOC / Fire Safety / Municipal Permission
  legalVerified   Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  rooms         Room[]
  announcements Announcement[]
  complaints    Complaint[]
}

model Room {
  id         String      @id @default(cuid())
  pgId       String
  pg         PG          @relation(fields: [pgId], references: [id], onDelete: Cascade)
  roomNumber String
  roomType   String      // "Single", "Double Sharing", "Triple Sharing", "Four Sharing"
  rent       Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  beds       Bed[]
  complaints Complaint[]
}

model Bed {
  id        String    @id @default(cuid())
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedNumber String    // e.g. "B1", "B2", "B3"
  status    String    @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings  Booking[]
}

model Booking {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bedId     String
  bed       Bed       @relation(fields: [bedId], references: [id], onDelete: Cascade)
  startDate DateTime  @default(now())
  endDate   DateTime?
  status    String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rents     Rent[]
}

model Rent {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month     String    // e.g. "October 2026"
  amount    Float
  dueDate   DateTime
  status    String    @default("PENDING") // PENDING, PAID, OVERDUE
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  payments  Payment[]
}

model Payment {
  id                String    @id @default(cuid())
  rentId            String
  rent              Rent      @relation(fields: [rentId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount            Float
  transactionId     String    @unique
  paymentMethod     String    @default("Razorpay - UPI/Card")
  status            String    @default("SUCCESS") // SUCCESS, FAILED, PENDING
  razorpayOrderId   String?
  razorpayPaymentId String?
  utrNumber         String?   // Student submitted 12-digit UPI UTR number
  paidAt            DateTime  @default(now())
}

model Announcement {
  id           String   @id @default(cuid())
  ownerId      String
  owner        Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pgId         String
  pg           PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  title        String
  message      String
  targetType   String   @default("ALL") // ALL, PG, ROOM
  targetRoomId String?
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // BOOKING, RENT, ANNOUNCEMENT, COMPLAINT, PAYMENT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Complaint {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  pgId           String
  pg             PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  roomId         String?
  room           Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  category       String   // "Electrical", "Plumbing", "Cleaning", "Wi-Fi", "Food", "Other"
  title          String
  description    String
  status         String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  resolutionNote String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
